<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<div class="toast-container" role="status" aria-live="polite">
  <c:if test="${not empty flashSuccess}">
    <div class="toast toast--success">
      <span class="material-symbols-outlined toast__icon">check_circle</span>
      <span class="toast__message"><c:out value="${flashSuccess}"/></span>
      <button type="button" class="toast__close" aria-label="${msg.ui_close}">
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>
  </c:if>
  <c:if test="${not empty flashError}">
    <div class="toast toast--error">
      <span class="material-symbols-outlined toast__icon">cancel</span>
      <span class="toast__message"><c:out value="${flashError}"/></span>
      <button type="button" class="toast__close" aria-label="${msg.ui_close}">
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>
  </c:if>
  <c:if test="${not empty flashWarning}">
    <div class="toast toast--warning">
      <span class="material-symbols-outlined toast__icon">warning</span>
      <span class="toast__message"><c:out value="${flashWarning}"/></span>
      <button type="button" class="toast__close" aria-label="${msg.ui_close}">
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>
  </c:if>
</div>
